---
import BlogCard from './BlogCard.astro'
import PostCounter from './PostCounter.astro'
import LoadingIndicator from './LoadingIndicator.astro'
import EmptyState from './EmptyState.astro'
import { MOCK_MODE } from '../utils/mockData'

export interface Props {
  allPosts: any[]
  initialPosts: any[]
  postsPerPage: number
}

const { allPosts, initialPosts, postsPerPage } = Astro.props
---

<section id="posts" class="bg-white py-10 dark:bg-gray-900">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Post Counter -->
    <PostCounter totalPosts={allPosts.length} mockMode={MOCK_MODE} />

    <!-- Posts Grid or Empty State -->
    {
      initialPosts.length > 0 ? (
        <div
          id="posts-grid"
          class="grid auto-rows-fr gap-8 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-4"
        >
          {initialPosts.map((post, index) => (
            <div
              class="blog-card-wrapper translate-y-8 opacity-0 transition-all duration-700 ease-out"
              data-index={index}
            >
              <BlogCard
                title={post.title}
                description={post.description}
                pubDate={post.pubDate}
                heroImage={post.heroImage}
                tags={post.tags}
                slug={post.slug}
              />
            </div>
          ))}
        </div>
      ) : (
        <EmptyState />
      )
    }

    <!-- Loading Indicator -->
    <LoadingIndicator />

    <!-- Infinite Scroll Trigger -->
    <div id="scroll-trigger" class="h-4"></div>
  </div>
</section>

<!-- Infinite Scroll Script -->
<script define:vars={{ allPosts, postsPerPage }}>
  console.log('🔍 Debug Info:', {
    allPostsCount: allPosts.length,
    postsPerPage,
    mockMode: true,
    initialPostsLength: allPosts.slice(0, postsPerPage).length,
  })

  document.addEventListener('DOMContentLoaded', function () {
    // Infinite scroll state
    let currentPage = 1
    let isLoading = false
    let hasMorePosts = allPosts.length > postsPerPage

    // Animation queue for better performance
    let animationQueue = []
    let isProcessingQueue = false

    function processAnimationQueue() {
      if (isProcessingQueue || animationQueue.length === 0) return

      isProcessingQueue = true
      const batchSize = 4
      const batch = animationQueue.splice(0, batchSize)

      batch.forEach((animate, batchIndex) => {
        setTimeout(animate, batchIndex * 50)
      })

      setTimeout(
        () => {
          isProcessingQueue = false
          if (animationQueue.length > 0) {
            processAnimationQueue()
          }
        },
        batch.length * 50 + 100,
      )
    }

    // Intersection observer for card animations
    const cardObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animationQueue.push(() => {
              requestAnimationFrame(() => {
                entry.target.classList.remove('opacity-0', 'translate-y-8')
                entry.target.classList.add('opacity-100', 'translate-y-0')
              })
            })
            cardObserver.unobserve(entry.target)
          }
        })
        processAnimationQueue()
      },
      {
        root: null,
        rootMargin: '100px',
        threshold: 0.1,
      },
    )

    // Function to create and add new blog cards
    function addNewPosts(posts, startIndex) {
      const postsGrid = document.getElementById('posts-grid')
      if (!postsGrid) return

      console.log(
        '🆕 Adding new posts:',
        posts.length,
        'starting at index:',
        startIndex,
      )

      posts.forEach((post, index) => {
        const cardWrapper = document.createElement('div')
        cardWrapper.className =
          'blog-card-wrapper translate-y-8 opacity-0 transition-all duration-700 ease-out'
        cardWrapper.setAttribute('data-index', String(startIndex + index))

        cardWrapper.innerHTML = `
          <article class="group h-full overflow-hidden rounded-xl bg-white shadow-lg transition-all duration-300 hover:shadow-xl dark:bg-gray-800 dark:shadow-gray-900/20">
            <div class="relative overflow-hidden">
              ${
                post.heroImage
                  ? `
                <img
                  src="${post.heroImage}"
                  alt="${post.title}"
                  class="h-48 w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  loading="lazy"
                />
              `
                  : `
                <div class="h-48 w-full bg-gradient-to-br from-blue-400 via-purple-500 to-pink-500 transition-transform duration-300 group-hover:scale-105"></div>
              `
              }
              <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
            </div>
            
            <div class="p-6">
              <div class="mb-3 flex flex-wrap gap-2">
                ${
                  post.tags
                    ? post.tags
                        .map(
                          (tag) => `
                  <span class="inline-block rounded-full bg-blue-100 px-3 py-1 text-xs font-medium text-blue-800 dark:bg-blue-900/20 dark:text-blue-400">
                    ${tag}
                  </span>
                `,
                        )
                        .join('')
                    : ''
                }
              </div>
              
              <h2 class="mb-3 line-clamp-2 text-xl font-bold text-gray-900 transition-colors group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400">
                ${post.title}
              </h2>
              
              <p class="mb-4 line-clamp-3 text-gray-600 dark:text-gray-300">
                ${post.description}
              </p>
              
              <div class="flex items-center justify-between">
                <time class="text-sm text-gray-500 dark:text-gray-400">
                  ${new Date(post.pubDate).toLocaleDateString('th-TH', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                
                <a
                  href="/blog/${post.slug}"
                  class="inline-flex items-center text-sm font-medium text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300"
                  aria-label="อ่านบทความ ${post.title}"
                >
                  อ่านต่อ
                  <svg class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        `

        postsGrid.appendChild(cardWrapper)
        cardObserver.observe(cardWrapper)
      })
    }

    // Function to load more posts
    function loadMorePosts() {
      if (isLoading || !hasMorePosts) return

      console.log('📥 Loading more posts...')
      isLoading = true
      const loadingIndicator = document.getElementById('loading-indicator')
      if (loadingIndicator) {
        loadingIndicator.classList.remove('hidden')
      }

      setTimeout(() => {
        const startIndex = currentPage * postsPerPage
        const endIndex = Math.min(startIndex + postsPerPage, allPosts.length)
        const newPosts = allPosts.slice(startIndex, endIndex)

        if (newPosts.length > 0) {
          addNewPosts(newPosts, startIndex)
          currentPage++
          hasMorePosts = endIndex < allPosts.length
        }

        isLoading = false
        if (loadingIndicator) {
          loadingIndicator.classList.add('hidden')
        }

        console.log('✅ More posts loaded:', {
          currentPage,
          hasMore: hasMorePosts,
          newPostsCount: newPosts.length,
        })
      }, 500)
    }

    // Intersection observer for infinite scroll trigger
    const scrollObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && hasMorePosts && !isLoading) {
            console.log('🔄 Scroll trigger activated!')
            loadMorePosts()
          }
        })
      },
      {
        root: null,
        rootMargin: '200px',
        threshold: 0.1,
      },
    )

    // Start observing scroll trigger
    const scrollTrigger = document.getElementById('scroll-trigger')
    if (scrollTrigger && hasMorePosts) {
      scrollObserver.observe(scrollTrigger)
      console.log('👀 Scroll trigger observer started')
    }

    // Animate initial cards
    const initialCards = document.querySelectorAll('.blog-card-wrapper')
    console.log('🎴 Found initial cards:', initialCards.length)

    const immediateShowCount = Math.min(8, initialCards.length)

    initialCards.forEach((card, index) => {
      if (index < immediateShowCount) {
        setTimeout(() => {
          requestAnimationFrame(() => {
            card.classList.remove('opacity-0', 'translate-y-8')
            card.classList.add('opacity-100', 'translate-y-0')
          })
        }, index * 25)
      } else {
        cardObserver.observe(card)
      }
    })

    // Emergency fallback
    setTimeout(() => {
      const hiddenCards = document.querySelectorAll(
        '.blog-card-wrapper.opacity-0',
      )
      if (hiddenCards.length > 0) {
        console.log('🚨 Emergency fallback: Showing all hidden cards')
        hiddenCards.forEach((card) => {
          card.classList.remove('opacity-0', 'translate-y-8')
          card.classList.add('opacity-100', 'translate-y-0')
        })
      }
    }, 2000)

    // Smooth scroll for anchor links
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault()
        const href = e.currentTarget.getAttribute('href')
        if (href) {
          const target = document.querySelector(href)
          if (target) {
            target.scrollIntoView({
              behavior: 'smooth',
              block: 'start',
            })
          }
        }
      })
    })
  })
</script>

<style>
  /* Grid responsive improvements */
  @media (min-width: 640px) {
    #posts-grid {
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    }
  }

  @media (min-width: 1024px) {
    #posts-grid {
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    }
  }

  @media (min-width: 1280px) {
    #posts-grid {
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      max-width: none;
    }
  }

  /* Line clamp utilities */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Blog card animations */
  .blog-card-wrapper {
    animation-fill-mode: both;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(2rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
