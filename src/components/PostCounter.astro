---
export interface Props {
  totalPosts: number
  mockMode: boolean
}

const { totalPosts, mockMode } = Astro.props
---

<div class="mb-12 text-center">
  {
    mockMode ? (
      <div class="inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-sm text-amber-800 dark:bg-amber-900/20 dark:text-amber-400">
        <svg class="mr-2 h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
          <path
            fill-rule="evenodd"
            d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z"
            clip-rule="evenodd"
          />
        </svg>
        โหมดจำลอง: ทั้งหมด {totalPosts.toLocaleString()} บทความ
      </div>
    ) : (
      <div class="inline-flex items-center rounded-full">
        ทั้งหมด {totalPosts.toLocaleString()} บทความ
      </div>
    )
  }
  <div class="flex justify-center">
    <div
      class="mt-6 h-1 w-20 rounded-full bg-gradient-to-r from-blue-500 to-purple-500"
    >
    </div>
  </div>
</div>
