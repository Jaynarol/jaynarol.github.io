---
import HeroSection from '../components/HeroSection.astro'
import InfiniteScrollContainer from '../components/InfiniteScrollContainer.astro'
import Layout from '../components/Layout.astro'
import { getPostsData } from '../utils/blogUtils'

// Configuration
const POSTS_PER_PAGE = 20

// Get blog posts data
const { allPosts, initialPosts } = await getPostsData(POSTS_PER_PAGE)
---

<Layout title="Jaynarol Blog - บล็อกแห่งการเรียนรู้และแบ่งปัน">
  <div class="min-h-screen">
    <!-- Hero Section -->
    <HeroSection />

    <!-- Infinite Scroll Container -->
    <InfiniteScrollContainer
      allPosts={allPosts}
      initialPosts={initialPosts}
      postsPerPage={POSTS_PER_PAGE}
    />
  </div>
</Layout>

<style>
  /* Smooth scrolling */
  html {
    scroll-behavior: smooth;
  }
</style>
