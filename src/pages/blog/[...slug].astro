---
import { getCollection, getEntry } from 'astro:content'
import BlogContent from '../../components/BlogContent.astro'
import BlogHero from '../../components/BlogHero.astro'
import Layout from '../../components/Layout.astro'
import RecommendedPosts from '../../components/RecommendedPosts.astro'
import { getOptimizedHeroImage } from '../../utils/blogUtils'
import { getRecommendedPosts } from '../../utils/recommendationUtils'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))
}

const { slug } = Astro.params
const post = await getEntry('blog', slug)
if (!post) throw new Error(`Post not found: ${slug}`)

const { Content } = await post.render()

// Get all posts for recommendations
const allPosts = await getCollection('blog', ({ data }) => !data.draft)
const recommendedPosts = getRecommendedPosts(allPosts, slug)
const { title, description, heroImage, heroColor } = post.data
const optimizedHeroImage = await getOptimizedHeroImage(heroImage, heroColor)
---

<Layout
  title={title}
  description={description}
  image={heroImage ? optimizedHeroImage : undefined}
>
  <BlogHero {...post.data} optimizedHeroImage={optimizedHeroImage} />
  <BlogContent Content={Content} />
  <RecommendedPosts posts={recommendedPosts} />
</Layout>
